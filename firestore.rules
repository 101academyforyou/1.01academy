rules_version = '2';

// 1.01 Academy — Firestore 安全規則
// 貼到 Firebase 主控台 → Firestore Database → 規則 → 發布
service cloud.firestore {
  match /databases/{database}/documents {

    // 已驗證 Email 的登入者
    function signedInEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    // 管理者名單：要新增管理者，在清單裡加上他的 Email（全部小寫）
    function isAdmin() {
      return signedInEmail()
        && request.auth.token.email.lower() in ['salimachchang@gmail.com'];
    }

    // courses/{課程id}：課程目錄（標題、介紹、封面、單元標題與說明）
    // 任何人都能讀（首頁要顯示）；只有管理者能新增、修改、刪除
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // access/{學生 Email（小寫）} = { courses: ['course1'], expires: { course1: 到期時間毫秒 } }
    // 學生只能讀自己的開通紀錄；只有管理者能修改
    match /access/{email} {
      allow read: if (signedInEmail() && request.auth.token.email.lower() == email) || isAdmin();
      allow write: if isAdmin();
    }

    // 免費課程：已上架，且售價為 0（永久免費）或現在在限時免費期間內
    // 限時免費期間：freeFrom（毫秒，0 = 立即）≤ 現在 < freeUntil（毫秒）
    function freeNow(d) {
      let now = request.time.toMillis();
      return d.get('published', true) != false
        && (d.get('price', 1) == 0
          || (d.get('freeUntil', 0) > now && d.get('freeFrom', 0) <= now));
    }

    function isFreeCourse(courseId) {
      let course = /databases/$(database)/documents/courses/$(courseId);
      return exists(course) && freeNow(get(course).data);
    }

    // 付費課程：access/{Email} 的 courses 裡有這門課，且在觀看期限內
    // expires/{課程id} = 到期時間（毫秒）；沒有設定 = 不限期限
    function isGranted(courseId) {
      let me = /databases/$(database)/documents/access/$(request.auth.token.email.lower());
      return exists(me) && courseId in get(me).data.courses
        && (get(me).data.get('expires', {}).get(courseId, 0) == 0
          || get(me).data.get('expires', {}).get(courseId, 0) > request.time.toMillis());
    }

    // courseVideos/{課程id} = { l1: 'YouTube 網址', l2: ... }
    // 管理者、免費課程的登入者、被開通的學生讀得到；只有管理者能修改
    match /courseVideos/{courseId} {
      allow read: if isAdmin() || (signedInEmail() && (isFreeCourse(courseId) || isGranted(courseId)));
      allow write: if isAdmin();
    }

    // orders/{訂單編號}：線上付款訂單，由 Cloud Functions 建立與更新
    // 學生只能讀自己的訂單；管理者可讀全部；網頁端一律不能寫入
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 其他資料一律禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
