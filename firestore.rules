rules_version = '2';

// 1.01 Academy — Firestore 安全規則
// 貼到 Firebase 主控台 → Firestore Database → 規則 → 發布
service cloud.firestore {
  match /databases/{database}/documents {

    // 已驗證 Email 的登入者
    function signedInEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    // 管理者名單：要新增管理者，在清單裡加上他的 Email（全部小寫）
    function isAdmin() {
      return signedInEmail()
        && request.auth.token.email.lower() in ['salimachchang@gmail.com'];
    }

    // courses/{課程id}：課程目錄（標題、介紹、封面、單元標題與說明）
    // 任何人都能讀（首頁要顯示）；只有管理者能新增、修改、刪除
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // access/{學生 Email（小寫）} = { courses: ['course1'], expires: { course1: 到期時間毫秒 }, notes: ['筆記id'] }
    // 學生只能讀自己的開通紀錄；只有管理者能修改
    match /access/{email} {
      allow read: if (signedInEmail() && request.auth.token.email.lower() == email) || isAdmin();
      allow write: if isAdmin();
    }

    // 免費課程：已上架，且售價為 0（永久免費）或現在在限時免費期間內
    // 限時免費期間：freeFrom（毫秒，0 = 立即）≤ 現在 < freeUntil（毫秒）
    function freeNow(d) {
      let now = request.time.toMillis();
      return d.get('published', true) != false
        && (d.get('price', 1) == 0
          || (d.get('freeUntil', 0) > now && d.get('freeFrom', 0) <= now));
    }

    function isFreeCourse(courseId) {
      let course = /databases/$(database)/documents/courses/$(courseId);
      return exists(course) && freeNow(get(course).data);
    }

    // 付費課程：access/{Email} 的 courses 裡有這門課，且在觀看期限內
    // expires/{課程id} = 到期時間（毫秒）；沒有設定 = 不限期限
    function isGranted(courseId) {
      let me = /databases/$(database)/documents/access/$(request.auth.token.email.lower());
      return exists(me) && courseId in get(me).data.courses
        && (get(me).data.get('expires', {}).get(courseId, 0) == 0
          || get(me).data.get('expires', {}).get(courseId, 0) > request.time.toMillis());
    }

    // 已加入這門免費課程（在課程頁按「免費加入課程」）
    function hasJoined(courseId) {
      return exists(/databases/$(database)/documents/enroll/$(request.auth.token.email.lower())/courses/$(courseId));
    }

    // enroll/{學生 Email（小寫）}/courses/{課程id} = { joinedAt }：學生自己加入的免費課程
    // 學生只能讀、加入自己的；只能加入「現在免費」的課程；管理者可讀全部、可刪除
    match /enroll/{email}/courses/{courseId} {
      allow read: if (signedInEmail() && request.auth.token.email.lower() == email) || isAdmin();
      allow create: if signedInEmail() && request.auth.token.email.lower() == email
        && isFreeCourse(courseId)
        && request.resource.data.keys().hasOnly(['joinedAt']);
      allow delete: if isAdmin();
    }

    // courseVideos/{課程id} = { l1: 'YouTube 網址', l2: ... }
    // 管理者、已加入的免費課程學生、被開通的學生讀得到；只有管理者能修改
    match /courseVideos/{courseId} {
      allow read: if isAdmin()
        || (signedInEmail() && ((isFreeCourse(courseId) && hasJoined(courseId)) || isGranted(courseId)));
      allow write: if isAdmin();
    }

    // notes/{筆記id}：筆記目錄（標題、介紹、價格、封面）；任何人都能讀，只有管理者能修改
    match /notes/{noteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // noteFiles/{筆記id} = { url: Google Drive 分享連結 }
    // 管理者、已購買的學生（access/{Email} 的 notes）、免費筆記的登入者讀得到；只有管理者能修改
    function isFreeNote(noteId) {
      let n = /databases/$(database)/documents/notes/$(noteId);
      return exists(n) && get(n).data.get('published', true) != false && get(n).data.get('price', 1) == 0;
    }
    function ownsNote(noteId) {
      let me = /databases/$(database)/documents/access/$(request.auth.token.email.lower());
      return exists(me) && noteId in get(me).data.get('notes', []);
    }
    match /noteFiles/{noteId} {
      allow read: if isAdmin() || (signedInEmail() && (isFreeNote(noteId) || ownsNote(noteId)));
      allow write: if isAdmin();
    }

    // coupons/{折扣碼}：只有管理者能讀寫（學生輸入的折扣碼由 Cloud Functions 檢查）
    match /coupons/{code} {
      allow read, write: if isAdmin();
    }
    // couponUses/{折扣碼}__{Email}：使用紀錄，由 Cloud Functions 寫入；管理者可讀
    match /couponUses/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // orders/{訂單編號}：線上付款訂單，由 Cloud Functions 建立與更新
    // 學生只能讀自己的訂單；管理者可讀全部；網頁端一律不能寫入
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 其他資料一律禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
