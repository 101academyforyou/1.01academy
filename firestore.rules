rules_version = '2';

// 1.01 Academy — Firestore 安全規則
// 貼到 Firebase 主控台 → Firestore Database → 規則 → 發布
service cloud.firestore {
  match /databases/{database}/documents {

    // 已驗證 Email 的登入者
    function signedInEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    // 管理者名單：要新增管理者，在清單裡加上他的 Email（全部小寫）
    function isAdmin() {
      return signedInEmail()
        && request.auth.token.email.lower() in ['salimachchang@gmail.com'];
    }

    // courses/{課程id}：課程目錄（標題、介紹、封面、單元標題與說明）
    // 任何人都能讀（首頁要顯示）；只有管理者能新增、修改、刪除
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // access/{學生 Email（小寫）} = { courses: ['course1'], expires: { course1: 到期時間毫秒 }, notes: ['筆記id'] }
    // 學生只能讀自己的開通紀錄；只有管理者能修改
    match /access/{email} {
      allow read: if (signedInEmail() && request.auth.token.email.lower() == email) || isAdmin();
      allow write: if isAdmin();
    }

    // 免費課程：已上架，且售價為 0（永久免費）或現在在限時免費期間內
    // 限時免費期間：freeFrom（毫秒，0 = 立即）≤ 現在 < freeUntil（毫秒）
    function freeNow(d) {
      let now = request.time.toMillis();
      return d.get('published', true) != false
        && (d.get('price', 1) == 0
          || (d.get('freeUntil', 0) > now && d.get('freeFrom', 0) <= now));
    }

    function isFreeCourse(courseId) {
      let course = /databases/$(database)/documents/courses/$(courseId);
      return exists(course) && freeNow(get(course).data);
    }

    // 付費課程：access/{Email} 的 courses 裡有這門課，且在觀看期限內
    // expires/{課程id} = 到期時間（毫秒）；沒有設定 = 不限期限
    function isGranted(courseId) {
      let me = /databases/$(database)/documents/access/$(request.auth.token.email.lower());
      return exists(me) && courseId in get(me).data.courses
        && (get(me).data.get('expires', {}).get(courseId, 0) == 0
          || get(me).data.get('expires', {}).get(courseId, 0) > request.time.toMillis());
    }

    // 已加入這門免費課程（在課程頁按「免費加入課程」）
    function hasJoined(courseId) {
      return exists(/databases/$(database)/documents/enroll/$(request.auth.token.email.lower())/courses/$(courseId));
    }

    // enroll/{學生 Email（小寫）}/courses/{課程id} = { joinedAt }：學生自己加入的免費課程
    // 學生只能讀、加入自己的；只能加入「現在免費」的課程；管理者可讀全部、可刪除
    match /enroll/{email}/courses/{courseId} {
      allow read: if (signedInEmail() && request.auth.token.email.lower() == email) || isAdmin();
      allow create: if signedInEmail() && request.auth.token.email.lower() == email
        && isFreeCourse(courseId)
        && request.resource.data.keys().hasOnly(['joinedAt']);
      // 學生可以把免費課程移出自己的「我的課程」
      allow delete: if isAdmin() || (signedInEmail() && request.auth.token.email.lower() == email);
    }

    // prefs/{Email} = { order: [課程id…], updatedAt }：學生自己在「我的課程」排的順序
    match /prefs/{email} {
      allow read: if signedInEmail() && request.auth.token.email.lower() == email;
      allow write: if signedInEmail() && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['order', 'updatedAt'])
        && request.resource.data.order is list && request.resource.data.order.size() <= 300;
    }

    // courseVideos/{課程id} = { l1: 'YouTube 網址', l2: ... }
    // 管理者、已加入的免費課程學生、被開通的學生讀得到；只有管理者能修改
    match /courseVideos/{courseId} {
      allow read: if isAdmin()
        || (signedInEmail() && ((isFreeCourse(courseId) && hasJoined(courseId)) || isGranted(courseId)));
      allow write: if isAdmin();
    }

    // notes/{筆記id}：筆記目錄（標題、介紹、價格、封面）；任何人都能讀，只有管理者能修改
    match /notes/{noteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // noteFiles/{筆記id} = { url: Google Drive 分享連結 }
    // 管理者、已購買的學生（access/{Email} 的 notes）、免費筆記的登入者讀得到；只有管理者能修改
    function isFreeNote(noteId) {
      let n = /databases/$(database)/documents/notes/$(noteId);
      return exists(n) && get(n).data.get('published', true) != false && get(n).data.get('price', 1) == 0;
    }
    function ownsNote(noteId) {
      let me = /databases/$(database)/documents/access/$(request.auth.token.email.lower());
      return exists(me) && noteId in get(me).data.get('notes', []);
    }
    match /noteFiles/{noteId} {
      allow read: if isAdmin() || (signedInEmail() && (isFreeNote(noteId) || ownsNote(noteId)));
      allow write: if isAdmin();
    }

    // coupons/{折扣碼}：只有管理者能讀寫（學生輸入的折扣碼由 Cloud Functions 檢查）
    match /coupons/{code} {
      allow read, write: if isAdmin();
    }
    // couponUses/{折扣碼}__{Email}：使用紀錄，由 Cloud Functions 寫入；管理者可讀
    match /couponUses/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // orders/{訂單編號}：線上付款訂單，由 Cloud Functions 建立與更新
    // 學生只能讀自己的訂單；管理者可讀全部；網頁端一律不能寫入
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---------- 循序漸進學伊斯蘭（islam.onepointzeroone.org）：共用帳號，所有課程免費 ----------
    // 伊斯蘭網站的管理者：1.01 Academy 的管理者，加上只管理伊斯蘭網站的人（Email 全部小寫）
    // 這份名單的人只能編輯 islam_ 開頭的資料，碰不到 1.01 Academy 的課程、學生、訂單、折扣碼
    function isIslamAdmin() {
      return isAdmin()
        || (signedInEmail() && request.auth.token.email.lower() in ['1.01academyforyou@gmail.com']);
    }

    // islam_courses/{課程id}：課程目錄，任何人可讀；只有管理者能修改
    match /islam_courses/{courseId} {
      allow read: if true;
      allow write: if isIslamAdmin();
    }
    function islamCourseOpen(courseId) {
      let c = /databases/$(database)/documents/islam_courses/$(courseId);
      return exists(c) && get(c).data.get('published', true) != false;
    }
    // islam_enroll/{Email}/courses/{課程id}：學生自己加入的課程（只能加入已上架的課程）
    match /islam_enroll/{email}/courses/{courseId} {
      allow read: if (signedInEmail() && request.auth.token.email.lower() == email) || isIslamAdmin();
      allow create: if signedInEmail() && request.auth.token.email.lower() == email
        && islamCourseOpen(courseId)
        && request.resource.data.keys().hasOnly(['joinedAt']);
      // 學生可以把課程移出自己的學習區
      allow delete: if isIslamAdmin() || (signedInEmail() && request.auth.token.email.lower() == email);
    }
    // islam_students/{Email} = { email, name, courses: { 課程id: 加入時間 }, updatedAt }：給管理者看的學生名單
    // 學生只能寫自己的；伊斯蘭網站管理者可讀全部
    match /islam_students/{email} {
      allow read: if isIslamAdmin() || (signedInEmail() && request.auth.token.email.lower() == email);
      allow write: if signedInEmail() && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['email', 'name', 'courses', 'updatedAt'])
        && request.resource.data.email == email
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.courses is map && request.resource.data.courses.size() <= 300;
      allow delete: if isIslamAdmin();
    }
    // islam_notes/{Email}/courses/{課程id} = { lessons: { 單元id: { text, updatedAt } }, updatedAt }：學生自己的上課筆記
    match /islam_notes/{email}/courses/{courseId} {
      allow read, delete: if signedInEmail() && request.auth.token.email.lower() == email;
      allow write: if signedInEmail() && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['lessons', 'updatedAt'])
        && request.resource.data.lessons is map && request.resource.data.lessons.size() <= 500;
    }
    // islam_counts/{課程id} = { n }：加入學習的累計人數，任何人可讀（移出學習區不會減少）
    // 每位學生每門課只算一次：加入時和 islam_enroll、islam_counted 在同一個批次寫入，只能 +1；管理者可以直接校正
    function islamEnrollPath(courseId) {
      return /databases/$(database)/documents/islam_enroll/$(request.auth.token.email.lower())/courses/$(courseId);
    }
    function islamCountedPath(courseId) {
      return /databases/$(database)/documents/islam_counted/$(request.auth.token.email.lower())/courses/$(courseId);
    }
    function islamFirstJoin(courseId) {
      return !exists(islamCountedPath(courseId)) && existsAfter(islamCountedPath(courseId)) && existsAfter(islamEnrollPath(courseId));
    }
    match /islam_counts/{courseId} {
      allow read: if true;
      allow write: if isIslamAdmin() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int;
      allow create: if signedInEmail() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1 && islamFirstJoin(courseId);
      allow update: if signedInEmail() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1 && islamFirstJoin(courseId);
    }
    // islam_counted/{Email}/courses/{課程id} = { at }：這位學生已經算進人數（不能修改、刪除）
    match /islam_counted/{email}/courses/{courseId} {
      allow read: if signedInEmail() && request.auth.token.email.lower() == email;
      allow create: if signedInEmail() && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['at']) && existsAfter(islamEnrollPath(courseId));
    }

    // islam_posts/{課程id}/posts/{留言id} = { uid, name, text, createdAt, replyTo, admin }：每門課的心得分享與交流區
    // 登入的人都看得到；加入這門課的學生（或管理者）才能發言；作者可以修改、刪除自己的留言，管理者可以刪除任何留言
    match /islam_posts/{courseId}/posts/{postId} {
      allow read: if signedInEmail();
      allow create: if signedInEmail()
        && (isIslamAdmin() || (islamCourseOpen(courseId)
          && exists(/databases/$(database)/documents/islam_enroll/$(request.auth.token.email.lower())/courses/$(courseId))))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt', 'replyTo', 'admin'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is number
        && request.resource.data.replyTo is string && request.resource.data.replyTo.size() <= 40
        && request.resource.data.admin == isIslamAdmin();
      allow update: if signedInEmail() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
      allow delete: if isIslamAdmin() || (signedInEmail() && resource.data.uid == request.auth.uid);
    }

    // islam_prefs/{Email} = { order: [課程id…], folders: [{ id, name, courses: [課程id…] }], updatedAt }
    // 學生自己在「我的學習區」排的順序與資料夾
    match /islam_prefs/{email} {
      allow read: if signedInEmail() && request.auth.token.email.lower() == email;
      allow write: if signedInEmail() && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['order', 'folders', 'updatedAt'])
        && request.resource.data.order is list && request.resource.data.order.size() <= 300
        && request.resource.data.get('folders', []) is list && request.resource.data.get('folders', []).size() <= 30;
    }
    // islam_courseVideos/{課程id}：管理者、已加入該課程的學生讀得到
    match /islam_courseVideos/{courseId} {
      allow read: if isIslamAdmin() || (signedInEmail() && islamCourseOpen(courseId)
        && exists(/databases/$(database)/documents/islam_enroll/$(request.auth.token.email.lower())/courses/$(courseId)));
      allow write: if isIslamAdmin();
    }

    // 其他資料一律禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
