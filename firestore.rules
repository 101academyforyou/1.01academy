rules_version = '2';

// 1.01 Academy — Firestore 安全規則
// 貼到 Firebase 主控台 → Firestore Database → 規則 → 發布
service cloud.firestore {
  match /databases/{database}/documents {

    // 已驗證 Email 的登入者
    function signedInEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    // 管理者名單：要新增管理者，在清單裡加上他的 Email（全部小寫）
    function isAdmin() {
      return signedInEmail()
        && request.auth.token.email.lower() in ['salimachchang@gmail.com'];
    }

    // courses/{課程id}：課程目錄（標題、介紹、封面、單元標題與說明）
    // 任何人都能讀（首頁要顯示）；只有管理者能新增、修改、刪除
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // access/{學生 Email（小寫）} = { courses: ['course1'] }
    // 學生只能讀自己的開通紀錄；只有管理者能修改
    match /access/{email} {
      allow read: if (signedInEmail() && request.auth.token.email.lower() == email) || isAdmin();
      allow write: if isAdmin();
    }

    // courseVideos/{課程id} = { l1: 'YouTube 網址', l2: ... }
    // 只有被開通該課程的學生和管理者讀得到；只有管理者能修改
    match /courseVideos/{courseId} {
      allow read: if isAdmin() || (signedInEmail()
        && exists(/databases/$(database)/documents/access/$(request.auth.token.email.lower()))
        && courseId in get(/databases/$(database)/documents/access/$(request.auth.token.email.lower())).data.courses);
      allow write: if isAdmin();
    }

    // 其他資料一律禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
